{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.test)",
      "Edit(./.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git filter-repo *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(docker compose down -v *)"
    ],
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protege-segredos.mjs\""
          }
        ]
      }
    ]
  }
}
